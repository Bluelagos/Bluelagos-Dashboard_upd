{
  "name": "blue-lagos-riverine-intelligence",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "extract:register": "node pipelines/report-register/extract.mjs",
    "pipeline:administrative": "node pipelines/administrative/fetch.mjs",
    "pipeline:osm": "node pipelines/osm/extract.mjs",
    "pipeline:osm:process": "node pipelines/osm/process.mjs",
    "pipeline:spatial": "node pipelines/osm/process.mjs && node pipelines/spatial/derive.mjs",
    "spatial:derive": "node pipelines/spatial/derive.mjs",
    "pipeline:validate": "node pipelines/validate.mjs",
    "snapshot:presentation": "node pipelines/snapshot.mjs",
    "presentation:check": "node pipelines/presentation-check.mjs",
    "import:csv": "node scripts/import-blue-lagos-csv.mjs",
    "import:csv:apply": "node scripts/import-blue-lagos-csv.mjs --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@turf/turf": "^7.4.0",
    "echarts": "^6.0.0",
    "h3-js": "^4.5.0",
    "lucide-react": "^0.542.0",
    "maplibre-gl": "^5.7.1",
    "next": "^16.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
