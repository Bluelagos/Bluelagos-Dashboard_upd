NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to allow the app to fall back to data/presentation-snapshot.json
# (built by `npm run snapshot:presentation`) when the live query fails. The UI
# labels this state "VERIFIED SNAPSHOT"; it is never a silent swap.
NEXT_PUBLIC_ALLOW_SNAPSHOT_FALLBACK=0
NEXT_PUBLIC_SATELLITE_TILES_URL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
EO_MANIFEST_PATH=
WORLDPOP_INPUT_PATH=
SPATIAL_OUTPUT_DIRECTORY=data/spatial
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY=
